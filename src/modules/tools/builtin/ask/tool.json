{
  "name": "ask",
  "description": "向用户提问并等待文本回复。当需要澄清、决策或仅用户能提供的信息时使用。返回用户的回复文本。调用会阻塞直到用户响应或超时（5 分钟）。",
  "icon": "help-circle",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "description": "要向用户提问的问题。请具体且简洁。"
      }
    },
    "required": ["question"],
    "additionalProperties": false
  },
  "config": {
    "defaults": { "enabled": true },
    "schema": {}
  }
}
