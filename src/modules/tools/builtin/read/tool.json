{
  "name": "read",
  "description": "读取文本文件内容，返回带行号的行。支持 offset 和 limit 进行部分读取。会自动检测并拒绝二进制文件。",
  "icon": "file-text",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "要读取的文件的绝对或相对路径"
      },
      "offset": {
        "type": "integer",
        "description": "开始读取的行号（从 1 开始，默认 1）。",
        "minimum": 1
      },
      "limit": {
        "type": "integer",
        "description": "最多读取的行数（默认 2000）。",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "config": {
    "defaults": { "enabled": true },
    "schema": {}
  }
}
