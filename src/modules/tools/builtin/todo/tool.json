{
  "name": "todo",
  "description": "管理当前会话的待办清单（每会话独立持久化）。action=\"create\" 加 text（可选 priority）新建；action=\"update\" 加 id 与 text/status/priority 至少一项修改；action=\"delete\" 加 id 删除；action=\"list\" 查看当前全部待办（含 id，操作前建议先 list）；action=\"reorder\" 加 orderedIds（全量 id 的新顺序排列）重排；action=\"batch_update\" 加 updates 数组一次批量更新多项（任一 id 无效则整体失败不写入）。开始多步任务时建议创建待办并在每步完成后更新状态。",
  "icon": "list-checks",
  "annotations": {
    "idempotentHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["create", "update", "delete", "list", "reorder", "batch_update"],
        "description": "要执行的操作"
      },
      "text": {
        "type": "string",
        "description": "待办文本内容。create 必填；update 可选"
      },
      "priority": {
        "type": "string",
        "enum": ["low", "medium", "high"],
        "description": "优先级（默认 medium）"
      },
      "id": {
        "type": "string",
        "description": "待办 id。update/delete 必填"
      },
      "status": {
        "type": "string",
        "enum": ["pending", "in_progress", "completed"],
        "description": "状态。仅 update/batch_update 使用"
      },
      "orderedIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "全量待办 id 按新顺序排列。仅 reorder 使用，必须是当前全部 id 的排列"
      },
      "updates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "待办 id" },
            "text": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
            "priority": { "type": "string", "enum": ["low", "medium", "high"] }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "description": "批量更新列表。仅 batch_update 使用"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "config": {
    "defaults": { "enabled": true },
    "schema": {}
  }
}
