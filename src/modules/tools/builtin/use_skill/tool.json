{
  "name": "use_skill",
  "description": "激活指定的 skill，返回其完整指令模板（渐进式披露第二级；目录式 skill 附带附属资源清单供按需读取）。先用 list_skill 发现可用技能；args 替换模板中的 {{placeholder}} 占位符。",
  "icon": "sparkles",
  "annotations": {
    "readOnlyHint": true,
    "idempotentHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "skill": {
        "type": "string",
        "description": "要调用的技能名称"
      },
      "args": {
        "type": "object",
        "description": "替换到技能提示词占位符中的参数（如 {topic: \"react hooks\"} 对应 {{topic}}）。",
        "additionalProperties": true
      }
    },
    "required": ["skill"],
    "additionalProperties": false
  },
  "config": {
    "defaults": { "enabled": true },
    "schema": {}
  }
}
