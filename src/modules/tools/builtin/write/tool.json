{
  "name": "write",
  "description": "将内容写入文件，如已存在则覆盖。强制 read-before-overwrite：覆盖已存在文件前必须先调用 read 工具读取该文件。流式原子写入（tmp+fsync+rename，防损坏，支持大文件）+ 哈希备份（支持 undo）。大文件自动跳过 diff 以防爆内存，返回写入摘要。此操作具有破坏性。",
  "icon": "file-plus",
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": true,
    "requireConfirmation": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": { "type": "string", "description": "要写入的文件的绝对或相对路径" },
      "content": { "type": "string", "description": "要写入文件的内容" },
      "createDirs": { "type": "boolean", "description": "是否在父目录不存在时自动创建（默认 true）" }
    },
    "required": ["path", "content"],
    "additionalProperties": false
  },
  "config": {
    "defaults": {
      "enabled": true,
      "requireConfirmation": true,
      "trackHistory": true,
      "requireReadBeforeOverwrite": true
    },
    "schema": {
      "trackHistory": { "type": "boolean" },
      "requireReadBeforeOverwrite": { "type": "boolean" }
    }
  }
}
