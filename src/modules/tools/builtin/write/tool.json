{
  "name": "write",
  "description": "将内容写入文件，如已存在则覆盖。当 createDirs 为 true 时自动创建父目录。此操作具有破坏性。",
  "icon": "file-plus",
  "annotations": {
    "destructiveHint": true,
    "requireConfirmation": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "要写入的文件的绝对或相对路径"
      },
      "content": {
        "type": "string",
        "description": "要写入文件的内容"
      },
      "createDirs": {
        "type": "boolean",
        "description": "是否在父目录不存在时自动创建（默认 true）"
      }
    },
    "required": ["path", "content"],
    "additionalProperties": false
  },
  "config": {
    "defaults": { "enabled": true, "requireConfirmation": true },
    "schema": {}
  }
}
