{
  "name": "undo",
  "description": "撤销最近一次文件变更（write/edit/delete）。从哈希备份恢复原内容。可指定 steps 撤销多次。仅本会话内有效。此操作具有破坏性（会覆盖当前文件状态）。",
  "icon": "undo-2",
  "annotations": {
    "destructiveHint": true,
    "requireConfirmation": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "steps": {
        "type": "integer",
        "description": "撤销步数（默认 1，最大 20）",
        "minimum": 1,
        "maximum": 20
      }
    },
    "additionalProperties": false
  },
  "config": {
    "defaults": {
      "enabled": true,
      "requireConfirmation": true
    },
    "schema": {}
  }
}
