{
  "name": "delete",
  "description": "删除文件或目录。对于目录，recursive 必须为 true（递归删除）。删除前自动哈希备份（支持 undo 恢复）。此操作具有破坏性。",
  "icon": "trash-2",
  "annotations": {
    "destructiveHint": true,
    "requireConfirmation": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "要删除的文件或目录的绝对或相对路径"
      },
      "recursive": {
        "type": "boolean",
        "description": "删除目录时必填。如果为 true，递归删除目录树。对文件忽略"
      }
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "config": {
    "defaults": {
      "enabled": true,
      "requireConfirmation": true,
      "trackHistory": true
    },
    "schema": {
      "trackHistory": { "type": "boolean" }
    }
  }
}
