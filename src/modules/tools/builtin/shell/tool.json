{
  "name": "shell",
  "description": "执行 shell 命令并返回 stdout、stderr 和退出码。默认超时 30 秒。使用 cwd 设置工作目录，shell 指定 shell 类型（Windows 默认 cmd 可选 powershell，POSIX 默认 bash）。警告：此工具以用户权限执行任意命令。",
  "icon": "terminal",
  "annotations": {
    "destructiveHint": true,
    "requireConfirmation": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "description": "要执行的 shell 命令"
      },
      "cwd": {
        "type": "string",
        "description": "命令的工作目录（默认：agent 工作目录）"
      },
      "timeout": {
        "type": "integer",
        "description": "超时时间（毫秒，默认 30000）。",
        "minimum": 1000,
        "maximum": 600000
      },
      "env": {
        "type": "object",
        "description": "额外的环境变量（与 process.env 合并）。",
        "additionalProperties": { "type": "string" }
      },
      "shell": {
        "type": "string",
        "enum": ["cmd", "powershell", "bash"],
        "description": "指定使用的 shell。Windows 默认 cmd（可选 powershell），macOS/Linux 默认 bash。"
      }
    },
    "required": ["command"],
    "additionalProperties": false
  },
  "config": {
    "defaults": { "enabled": true, "timeout": 30000, "requireConfirmation": true },
    "schema": {
      "timeout": { "type": "integer", "min": 1000, "max": 600000 }
    }
  }
}
